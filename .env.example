# Copy this file to .env and add your Groq API key.
GROQ_API_KEY=

# AI models and response limits
VISION_MODEL=qwen/qwen3.8-27b
CHAT_MODEL=openai/gpt-oss-120b
CHAT_REASONING_EFFORT=low
MAX_TOKENS_DESCRIBE=400
MAX_TOKENS_SCREEN=900
MAX_TOKENS_CHAT=1500

# Screen watching and capture
CHECK_INTERVAL=2
MIN_SECONDS_BETWEEN_ANALYSES=5
MONITOR=1
IMAGE_MAX_SIZE=1280
JPEG_QUALITY=70
SAME_SCREEN_THRESHOLD=5

# Storage
DATA_DIR=data
SAVE_IMAGES=false
IMAGE_KEEP_DAYS=3

# Comma-separated privacy blocklists
BLOCKED_KEYWORDS=password,bank,incognito,private browsing,inprivate,paypal,upi,credit card,login,sign in,otp
BLOCKED_APPS=1password,bitwarden,keepass,lastpass,whatsapp,telegram,signal,authenticator
